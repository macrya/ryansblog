# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY=""

# APP_URL: Canonical public URL where the application is hosted (e.g., https://markryan.vercel.app).
# On Vercel, this is also available via VERCEL_URL.
APP_URL=""

# VERCEL BLOB STORAGE
# Automatically generated when creating a Vercel Blob store in the Vercel Dashboard (Storage -> Create -> Blob).
# Required for 16:9 header image uploads and automatic deletion via del().
BLOB_READ_WRITE_TOKEN=""

# CMS ADMINISTRATOR AUTHENTICATION
# Passcode required to enter the Admin CMS Dashboard and perform privileged operations.
# Generate a cryptographically strong secret passphrase (min 16+ chars).
ADMIN_PASSWORD=""

