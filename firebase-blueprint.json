{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized site administrators",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator email"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "superadmin"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "Poem": {
      "title": "Poem",
      "description": "Poetry collection pieces",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "stanzas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Serialized stanzas or poem lines"
        },
        "date": { "type": "string" },
        "theme": {
          "type": "string",
          "enum": ["Love", "Existentialism", "Memory", "Transience"]
        },
        "quoteExcerpt": { "type": "string" },
        "dedication": { "type": "string" }
      },
      "required": ["id", "title", "stanzas", "date", "theme"]
    },
    "CuriosityEssay": {
      "title": "CuriosityEssay",
      "description": "Horology, aerodynamics, and curious technical essays",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["F1 Aerodynamics", "90s Combustion", "Mechanical Horology", "Urban Geography"]
        },
        "summary": { "type": "string" },
        "content": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Essay paragraphs"
        },
        "readTime": { "type": "string" },
        "year": { "type": "string" },
        "keyDiagramNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string" },
              "definition": { "type": "string" }
            },
            "required": ["term", "definition"]
          }
        },
        "specSheet": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["label", "value"]
          }
        }
      },
      "required": ["id", "title", "category", "readTime", "year", "summary", "content"]
    },
    "ComputerArticle": {
      "title": "ComputerArticle",
      "description": "UNIX architecture, retro computing, and software systems essays",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "date": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["OSINT Reconnaissance", "Systems Philosophy", "Low-Level Networking"]
        },
        "philosophicalThesis": { "type": "string" },
        "body": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Article body paragraphs"
        },
        "codeBlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "filename": { "type": "string" },
              "language": {
                "type": "string",
                "enum": ["python", "bash", "c", "rust"]
              },
              "code": { "type": "string" },
              "annotations": { "type": "string" }
            },
            "required": ["id", "filename", "language", "code"]
          }
        }
      },
      "required": ["id", "title", "subtitle", "date", "category", "philosophicalThesis", "body"]
    },
    "DiaryPost": {
      "title": "DiaryPost",
      "description": "Personal developer and poetic reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "mood": { "type": "string" },
        "weather": { "type": "string" },
        "location": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "time", "content"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Reader comments on diary and blog entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "flagged"]
        },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "postId", "authorName", "content", "createdAt", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System configuration and initialization records",
      "type": "object",
      "properties": {
        "seededAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized site administrators"
    },
    "/poems/{poemId}": {
      "schema": { "$ref": "#/entities/Poem" },
      "description": "Poetry collection items"
    },
    "/curiosities/{curiosityId}": {
      "schema": { "$ref": "#/entities/CuriosityEssay" },
      "description": "Curiosity and engineering essays"
    },
    "/computerArticles/{articleId}": {
      "schema": { "$ref": "#/entities/ComputerArticle" },
      "description": "UNIX and computing articles"
    },
    "/diaryPosts/{postId}": {
      "schema": { "$ref": "#/entities/DiaryPost" },
      "description": "Diary and journal entries"
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Reader reflections and comments"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "System state flags and settings"
    }
  }
}
